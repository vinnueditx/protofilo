            width: 45px;
            height: 45px;
            display: flex;
            justify-content: center;
            align-items: center;
            border: 1px solid #3b4055;
            border-radius: 50%;
            transition: 0.3s;
        }

        .social-icons a:hover {
            background: #00e5ff;
            color: #0d0f18;
            transform: translateY(-5px);
        }

        /* =========================
           ABOUT
        ========================= */
