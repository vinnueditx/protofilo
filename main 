            margin-bottom: 15px;
        }

        /* =========================
           EDUCATION
        ========================= */
        .timeline {
            max-width: 800px;
            margin: auto;
        }

        .timeline-item {
            background: #202334;
            border-left: 4px solid #00e5ff;
            padding: 25px;
            margin-bottom: 25px;
            border-radius: 10px;
        }

        .timeline-item h3 {
            color: #00e5ff;
        }

        .timeline-item h4 {
            margin: 5px 0;
        }

        .timeline-item p {
            color: #94a3b8;
        }

        /* =========================
           SKILLS
        ========================= */
        .skills-container {
            max-width: 900px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 25px;
        }

        .skill-box {
            background: #202334;
            padding: 25px;
            border-radius: 12px;
            transition: 0.3s;
        }

        .skill-box:hover {
            transform: translateY(-5px);
        }

        .skill-box h3 {
            margin-bottom: 20px;
            color: #00e5ff;
        }

        .skill {
            margin-bottom: 15px;
        }

        .skill-name {
            display: flex;
            justify-content: space-between;
            margin-bottom: 6px;
            font-size: 15px;
        }

        .progress {
            width: 100%;
            height: 8px;
            background: #3b4055;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress span {
            display: block;
            height: 100%;
            background: #00e5ff;
            border-radius: 10px;
        }

        /* =========================
           PROJECTS
        ========================= */
        .cards {
            max-width: 1100px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 25px;
        }

        .card {
            background: #202334;
            padding: 30px;
            border-radius: 15px;
            transition: 0.3s;
            border: 1px solid transparent;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card:hover {
            transform: translateY(-8px);
            border-color: #00e5ff;
        }

        .card h3 {
            color: #00e5ff;
            margin-bottom: 12px;
        }

        .card p {
            color: #94a3b8;
            margin-bottom: 20px;
            font-size: 14px;
        }

        /* =========================
           CONTACT & FOOTER
        ========================= */
        .contact-container {
            max-width: 700px;
            margin: auto;
            text-align: center;
            background: #202334;
            padding: 40px;
            border-radius: 15px;
        }

        .contact-container p {
            color: #94a3b8;
            margin: 10px 0 25px;
        }

        footer {
            text-align: center;
            padding: 25px;
            background: #0d0f18;
            color: #94a3b8;
        }

        /* =========================
           RESPONSIVE DESIGN
        ========================= */
        @media (max-width: 768px) {
            nav { padding: 18px 5%; }
            nav ul { gap: 12px; }
            nav ul li a { font-size: 13px; }
            .home-content h1 { font-size: 42px; }
            .home-content h2 { font-size: 22px; }
