<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vinay | Portfolio</title>

    <style>
        /* =========================
           BASIC RESET
        ========================= */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: Arial, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background: linear-gradient(135deg, #0d0f18, #171a29, #2a1b3d);
            color: #f8fafc;
            line-height: 1.6;
            min-height: 100vh;
        }

        a {
            text-decoration: none;
            color: white;
        }

        /* =========================
           SCROLL ANIMATIONS
        ========================= */
        section {
            opacity: 0;
            transform: translateY(40px);
            transition: opacity 0.8s ease, transform 0.8s ease;
            padding: 100px 8%;
        }

        section.show {
            opacity: 1;
            transform: translateY(0);
        }

        /* =========================
           NAVBAR
        ========================= */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 18px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(13, 15, 24, 0.9);
            backdrop-filter: blur(10px);
            z-index: 1000;
        }

        .logo {
            font-size: 26px;
            font-weight: bold;
            color: #00e5ff;
        }

        nav ul {
            display: flex;
            gap: 25px;
            list-style: none;
        }

        nav ul li a {
            font-size: 16px;
            transition: 0.3s;
        }

        nav ul li a:hover,
        nav ul li a.active {
            color: #00e5ff;
        }

        /* =========================
           GENERAL HEADINGS
        ========================= */
        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title h2 {
            font-size: 38px;
            color: #00e5ff;
            margin-bottom: 10px;
        }

        .section-title p {
            color: #94a3b8;
        }

        /* =========================
           HOME
        ========================= */
        #home {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            text-align: center;
            padding-top: 120px;
        }

        .home-content {
            max-width: 800px;
        }

        .home-content h3 {
            color: #94a3b8;
            font-size: 22px;
            margin-bottom: 10px;
        }

        .home-content h1 {
            font-size: 60px;
            margin-bottom: 15px;
        }

        .home-content h1 span {
            color: #00e5ff;
        }

        .home-content h2 {
            font-size: 28px;
            color: #cbd5e1;
            margin-bottom: 20px;
            min-height: 40px;
        }

        .home-content h2::after {
            content: "|";
            color: #00e5ff;
            margin-left: 5px;
            animation: blink 0.7s infinite;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        .home-content p {
            color: #94a3b8;
            font-size: 18px;
            margin-bottom: 30px;
        }

        /* =========================
           BUTTONS & ICONS
        ========================= */
        .buttons {
            margin-bottom: 30px;
        }

        .btn {
            display: inline-block;
            padding: 13px 28px;
            margin: 5px;
            border-radius: 30px;
            background: #00e5ff;
            color: #0d0f18;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn:hover {
            transform: translateY(-3px);
            background: white;
        }

        .btn-outline {
            background: transparent;
            color: #00e5ff;
            border: 2px solid #00e5ff;
        }

        .btn-outline:hover {
            background: #00e5ff;
            color: #0d0f18;
        }

        .social-icons {
            display: flex;
            justify-content: center;
            gap: 20px;
        }

